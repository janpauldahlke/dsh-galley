{
  "name": "dsh-galley",
  "version": "0.2.5",
  "description": "Shared volatile document workbench & typesetter (Druck und Satz) for human + agent co-authoring in DeepSeek Harness. Block-addressed galley packets, instant Typst A4 proof, deterministic PDF/DOCX/TYP exporters.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "fonts",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "media"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janpauldahlke/dsh-galley.git"
  },
  "homepage": "https://github.com/janpauldahlke/dsh-galley#readme",
  "bugs": {
    "url": "https://github.com/janpauldahlke/dsh-galley/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs && tsc --noEmit",
    "prepare": "node build.mjs",
    "prepublishOnly": "npm run build && npm test",
    "test": "node build.mjs && node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "cordis",
    "cordis-plugin",
    "typst",
    "typesetting",
    "document-workbench",
    "galley"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "dsh-build-tools": "^0.2.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "author": {
    "name": "Jan (HagbardCeline)",
    "email": "janpauldahlke@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
